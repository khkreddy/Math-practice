%% physfig.sty -- parameterised physics figures for worksheets (TikZ)
%% Original implementation written for Hari's teaching use. The option set
%% mirrors the generators on physicsfigures.com (teacher.dev); see OPTIONS.md.
%% Figure ideas based on physicsfigures.com (teacher.dev).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{physfig}[2026/10/11 v0.9 parameterised physics figures]
\RequirePackage{tikz}
\RequirePackage{amsmath}
\RequirePackage{bm}
\RequirePackage{xfp}
\usetikzlibrary{arrows.meta,calc,patterns,decorations.pathmorphing,decorations.markings}
\newif\ifpf@circuits \pf@circuitstrue
\DeclareOption{nocircuits}{\pf@circuitsfalse}
\ProcessOptions\relax
\ifpf@circuits\RequirePackage{circuitikz}\fi
\ExplSyntaxOn
% \pf@ifstr{a}{b}{true}{false}
\cs_new:Npn \pf@ifstr #1#2 { \str_if_eq:eeTF {#1} {#2} }
\ExplSyntaxOff
%% ------------------------------------------------------------------ colours
\definecolor{pfink}{HTML}{111827}
\definecolor{pfbody}{HTML}{E5E7EB}
\definecolor{pframp}{HTML}{F3F4F6}
\definecolor{pfgrid}{HTML}{9CA3AF}
\definecolor{pfred}{HTML}{DC2626}
\definecolor{pfblue}{HTML}{2563EB}
\definecolor{pfgreen}{HTML}{16A34A}
\definecolor{pforange}{HTML}{EA580C}
\definecolor{pfpurple}{HTML}{9333EA}
\definecolor{pfteal}{HTML}{0D9488}
\definecolor{pfpink}{HTML}{DB2777}
\definecolor{pfbrown}{HTML}{A16207}
\newif\ifpf@color
% colour for the n-th force/vector when color=true, ink otherwise
\def\pf@palette#1{\ifpf@color\ifcase\numexpr #1\relax pfink\or pfred\or pfblue\or pfgreen\or pforange\or pfpurple\or pfteal\or pfpink\or pfbrown\else pfink\fi\else pfink\fi}
%% ------------------------------------------------------------------ global style
\tikzset{
  pf/.style={line cap=butt, line join=round, color=pfink, every node/.append style={inner sep=1.5pt, font=\pf@font}},
  pf force/.style={line width=1.6pt, -{Triangle[length=8pt,width=6.5pt]}},
  pf motion/.style={line width=1.3pt, dash pattern=on 4pt off 2.5pt, -{Triangle[length=7pt,width=5.5pt]}},
  pf thin arrow/.style={line width=0.6pt, -{Stealth[length=5pt,width=4pt]}},
  pf dim/.style={line width=0.6pt, {Bar[width=6pt]Stealth[length=5pt,width=4pt]}-{Stealth[length=5pt,width=4pt]Bar[width=6pt]}},
  pf body/.style={fill=pfbody, draw=pfink, line width=1.3pt},
  pf halo/.style={fill=white, inner sep=1pt, rounded corners=1pt},
  pf ground/.style={line width=1pt},
}
\def\pf@font{\normalsize}
\newcommand\physfigset[1]{\pgfqkeys{/pf}{#1}}
\pgfqkeys{/pf}{font/.code={\def\pf@font{#1}}, blank width/.initial=1.4em}
%% label helper: {} = none, ? = blank line, anything else = math
\newcommand\pf@labX[1]{\pf@ifstr{\detokenize{#1}}{}{}{\pf@ifstr{\detokenize{#1}}{?}{\rule[-0.2ex]{\pgfkeysvalueof{/pf/blank width}}{0.5pt}}{$#1$}}}
\newcommand\pf@ifnolabX[3]{\pf@ifstr{\detokenize{#1}}{}{#2}{#3}}
% vector notation: arrow over / bold first token (F_g -> \vec{F}_g)
\def\pf@notation{none}
\def\pf@vecA#1#2\pf@end{\vec{#1}#2}
\def\pf@vecB#1#2\pf@end{\bm{#1}#2}
\newcommand\pf@vlabX[1]{\pf@ifstr{\detokenize{#1}}{}{}{\pf@ifstr{\detokenize{#1}}{?}{\pf@labX{?}}{%
  \pf@ifstr{\pf@notation}{arrow}{$\pf@vecA#1\pf@end$}{\pf@ifstr{\pf@notation}{bold}{$\pf@vecB#1\pf@end$}{$#1$}}}}}
\ExplSyntaxOn
\cs_new:Npn \pf@lab #1 { \exp_args:Nf \pf@labX {#1} }
\cs_new:Npn \pf@vlab #1 { \exp_args:Nf \pf@vlabX {#1} }
\cs_new:Npn \pf@ifnolab #1 { \exp_args:Nf \pf@ifnolabX {#1} }
\ExplSyntaxOff
% ground hatching from (#1) to (#2)
\newcommand\pf@ground[2]{%
  \draw[pf ground] (#1) -- (#2);
  \path (#1) coordinate (pf@g1) (#2) coordinate (pf@g2);
  \pgfpointdiff{\pgfpointanchor{pf@g1}{center}}{\pgfpointanchor{pf@g2}{center}}%
  \pgfmathsetmacro\pf@glen{veclen(\pgf@x,\pgf@y)/28.4528}%
  \pgfmathtruncatemacro\pf@gn{\pf@glen/0.18}%
  \foreach \pf@k in {0,...,\pf@gn}{\draw[line width=0.5pt] ($(pf@g1)!{\pf@k/(\pf@gn+0.0001)}!(pf@g2)$) -- ++(-0.12,-0.14);}}
% polar helper: \pf@pol{angle}{len} -> coordinates
\newcommand\pf@x[2]{\fpeval{round((#2)*cosd(#1),4)}}
\newcommand\pf@y[2]{\fpeval{round((#2)*sind(#1),4)}}
% list helper: append #2 (braced) to macro #1
\newcommand\pf@append[2]{\ifx#1\relax\def#1{}\fi\expandafter\def\expandafter#1\expandafter{#1\pf@item{#2}}}
\newcommand\pf@nth[2]{% #1 list, #2 index -> \pf@got
  \begingroup\count@=0\relax\def\pf@got{}%
  \def\pf@item##1{\advance\count@ 1\relax\ifnum\count@=#2\relax\gdef\pf@gotg{##1}\fi}%
  \gdef\pf@gotg{}#1\endgroup\let\pf@got\pf@gotg}
% label placed at a point on the side given by a global direction (mirror aware)
\newif\ifpf@mirror
\newcommand\pf@manc[1]{\fpeval{(\ifpf@mirror 180-(#1)\else #1\fi)+180}}
\newcommand\pf@labat[3]{\node[anchor=\pf@manc{#2}] at (#1) {#3};}
% dimension line with end bars between two points, label on the side of global angle #4
\newcommand\pf@dimline[4]{\draw[pf dim] (#1) -- (#2) node[pos=0.5, anchor=\pf@manc{#3}, inner sep=3pt]{#4};}

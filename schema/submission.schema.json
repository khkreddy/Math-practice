{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khkreddy/Math-practice/schema/submission.schema.json",
  "title": "Submission",
  "description": "What POST /submit/:id stores. Photos are base64 JPEG, each stored value <= 1 MB. Do not commit a real submission to this repository.",
  "type": "object",
  "required": ["sheet_id", "submitted_at", "answers"],
  "properties": {
    "sheet_id": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "answers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/answer" }
    },
    "timing": {
      "type": "object",
      "description": "Optional per-question timing from the page. An I don't know flag clears that answer and is not a wrong answer.",
      "additionalProperties": { "$ref": "#/$defs/timing" }
    }
  },
  "$defs": {
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_seen_at": { "type": ["string", "null"] },
        "time_on_question_ms": { "type": "number", "minimum": 0 },
        "edit_count": { "type": "integer", "minimum": 0 },
        "idk": { "type": "boolean" }
      }
    },
    "answer": {
      "type": "object",
      "properties": {
        "value": { "type": "string" },
        "idk": { "type": "boolean", "description": "The student pressed I don't know. No answer value is stored." },
        "photo": { "type": "string", "description": "Base64 JPEG without a data: prefix. Max 1 MB." },
        "content_type": { "const": "image/jpeg" },
        "parts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/answer" }
        }
      }
    }
  }
}
